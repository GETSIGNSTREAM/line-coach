# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://epfxzpemsbeljspfwuwe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT
JWT_SECRET=your-jwt-secret-here

# Toast POS Webhook
TOAST_WEBHOOK_SECRET=your-toast-webhook-bearer-token-here

# Admin
ADMIN_PASSWORD=your-admin-password-here

# Device auth (bump / unbump / checklists / bird log / device registration)
# Unset or '0' = grace period: writes from unpaired screens are allowed and
# logged with a [device-auth] warning. This is what keeps the already-deployed
# Pi kiosks alive while each one is paired in the admin Devices tab.
# '1' = enforce. Flip ONLY after every screen shows as paired — anything still
# listed "UNPAIRED" stops bumping the moment this is on.
# Revocation works in BOTH modes: a revoked device is rejected even during the
# grace period.
# LC_REQUIRE_DEVICE_AUTH=1

# Feedback tips (Momos reviews → Claude → kitchen display)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional overrides:
# LC_FEEDBACK_TIPS_MODEL=claude-opus-4-8   # set claude-sonnet-5 / claude-haiku-4-5 to cut cost
# LC_FEEDBACK_MOCK=1                       # dev only: canned reviews instead of the momos table

# Learn mode — Notion Culinary OS sync (admin "Sync from Notion" button)
NOTION_API_KEY=your-notion-integration-secret-here
# Optional: defaults to the Culinary OS parent page; set to point directly
# at the Line Build Guides page or database.
# NOTION_RECIPES_PAGE_ID=...
# LC_RECIPE_SYNC_MODEL=claude-opus-4-8
